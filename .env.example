# Cloudflare Resource Tagging Demo — Environment Variables
#
# Copy this file to .env and fill in your credentials.
# .env is gitignored and will never be committed.
#
# Account ID: found on the right sidebar of any Cloudflare dashboard page
ACCOUNT_ID=your-account-id-here

# API Token: create an Account Owned Token with Account > Resource Tagging > Edit
# https://dash.cloudflare.com/profile/api-tokens -> Account API Tokens
API_TOKEN=your-api-token-here

# (Optional) Zone ID for the zone tagging demo
# If set, the demo will also tag a zone using zone-level endpoints.
# Find it on the right sidebar of any zone's overview page.
ZONE_ID=your-zone-id-here
